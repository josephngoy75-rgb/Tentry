# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
MAIL_DRIVER=log
MAIL_FROM="Talentry <no-reply@talentry.local>"
APP_PUBLIC_URL=http://localhost:3333
# Pour envoyer de vrais emails : MAIL_DRIVER=smtp + SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD
