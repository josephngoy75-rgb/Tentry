@layouts.app({ title: 'Candidatures' })
  @let(priorityLabels = { high: 'Prioritaire', medium: 'À examiner', low: 'Faible' })
  @let(statusLabels = { new: 'Nouveau', reviewed: 'Examiné', accepted: 'Retenu', rejected: 'Refusé' })

  <div class="page">
    <div class="page__header">
      <div>
        <h1 class="page__title">Candidatures</h1>
        <p class="page__description">Classées par score : les profils à examiner en premier sont en haut.</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <span class="stat__value">{{ total }}</span>
        <span class="stat__label">Candidatures</span>
      </div>
      <div class="stat stat--high">
        <span class="stat__value">{{ counts.high }}</span>
        <span class="stat__label">Prioritaires</span>
      </div>
      <div class="stat stat--medium">
        <span class="stat__value">{{ counts.medium }}</span>
        <span class="stat__label">À examiner</span>
      </div>
      <div class="stat stat--low">
        <span class="stat__value">{{ counts.low }}</span>
        <span class="stat__label">Faibles</span>
      </div>
    </div>

    <form method="GET" action="/dashboard" class="filters" x-data x-on:change="$el.submit()">
      <select name="program" class="field__input">
        <option value="">Tous les programmes</option>
        @each((item, key) in programs)
          <option value="{{ key }}" {{ filters.program === key ? 'selected' : '' }}>{{ item.label }}</option>
        @end
      </select>

      <select name="priority" class="field__input">
        <option value="">Toutes les priorités</option>
        @each((label, key) in priorityLabels)
          <option value="{{ key }}" {{ filters.priority === key ? 'selected' : '' }}>{{ label }}</option>
        @end
      </select>

      <select name="status" class="field__input">
        <option value="">Tous les statuts</option>
        @each((label, key) in statusLabels)
          <option value="{{ key }}" {{ filters.status === key ? 'selected' : '' }}>{{ label }}</option>
        @end
      </select>

      <a href="/dashboard" class="btn btn--secondary btn--sm">Réinitialiser</a>
    </form>

    @if(applications.length)
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>#</th>
              <th>Candidat</th>
              <th>Programme</th>
              <th>Score</th>
              <th>Priorité</th>
              <th>Statut</th>
              <th>Reçue le</th>
            </tr>
          </thead>
          <tbody>
            @each((application, index) in applications)
              <tr>
                <td class="table__rank">{{ rankOffset + index + 1 }}</td>
                <td>
                  <a href="/dashboard/{{ application.id }}" class="table__name table__link">{{ application.fullName }}</a>
                  <div class="table__sub">{{ application.email }}</div>
                </td>
                <td>{{ programs[application.program]?.label ?? application.program }}</td>
                <td><span class="table__score">{{ application.score }}</span><span class="table__sub"> / 100</span></td>
                <td>
                  <span class="badge badge--{{ application.priority }}">
                    {{ priorityLabels[application.priority] ?? application.priority }}
                  </span>
                </td>
                <td>{{ statusLabels[application.status] ?? application.status }}</td>
                <td>{{ application.createdAt.toFormat('dd/MM/yyyy') }}</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>

      @if(applications.hasPages)
        <div class="pager">
          @if(applications.currentPage > 1)
            <a class="btn btn--secondary btn--sm" href="{{ applications.getUrl(applications.currentPage - 1) }}">← Précédent</a>
          @end
          <span class="table__sub">Page {{ applications.currentPage }} / {{ applications.lastPage }}</span>
          @if(applications.hasMorePages)
            <a class="btn btn--secondary btn--sm" href="{{ applications.getUrl(applications.currentPage + 1) }}">Suivant →</a>
          @end
        </div>
      @end
    @else
      <div class="panel" style="text-align: center; color: var(--muted);">
        Aucune candidature ne correspond à ces filtres.
      </div>
    @end
  </div>
@end