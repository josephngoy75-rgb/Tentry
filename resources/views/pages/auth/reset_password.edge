@layouts.auth()
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">Choisissez un mot de passe d'au moins 8 caractères.</p>

  <form
    method="POST"
    action="/reinitialiser-mot-de-passe/{{ token }}"
    class="auth__form"
    x-data="{ submitting: false }"
    x-on:submit="submitting = true"
  >
    {{ csrfField() }}
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmez le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Enregistrer le mot de passe',
      type: 'submit',
      block: true,
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Enregistrement…' : 'Enregistrer le mot de passe'",
    })
  </form>
@end
