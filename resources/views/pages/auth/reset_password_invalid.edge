@layouts.auth()
  <h1 class="auth__title">Lien invalide ou expiré</h1>
  <p class="auth__sub">
    Ce lien n'est plus utilisable : il a peut-être déjà servi ou dépassé sa durée de validité d'une heure.
  </p>

  <p class="auth__foot">
    <a href="/mot-de-passe-oublie" class="il">Demander un nouveau lien</a>
  </p>
@end
