@layouts.auth()
  <h1 class="auth__title">Vérifiez votre boîte mail</h1>
  <p class="auth__sub">
    Si un compte existe pour cette adresse, un email contenant un lien de réinitialisation vient
    d'être envoyé. Le lien est valable 1 heure.
  </p>
  <p class="auth__sub">Pensez à regarder dans vos courriers indésirables.</p>

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end
