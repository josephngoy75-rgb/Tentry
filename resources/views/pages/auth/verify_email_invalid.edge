@layouts.auth()
  <h1 class="auth__title">Lien invalide ou expiré</h1>
  <p class="auth__sub">
    Ce lien n'est plus utilisable : il a peut-être déjà servi, été remplacé par un lien plus récent
    ou dépassé sa durée de validité de 24 heures.
  </p>

  <p class="auth__foot">
    <a href="/mon-espace" class="il">Se connecter pour recevoir un nouveau lien</a>
  </p>
@end
