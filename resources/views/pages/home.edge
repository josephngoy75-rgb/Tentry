@layouts.skullvi({ title: 'SKULLVI — Candidatures' })
  <main class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h1 class="font-script text-5xl text-brand-green">Transforme ton savoir en succès</h1>
    <p class="mt-5 text-lg text-gray-600">
      Rejoignez SKULLVI comme tuteur, ambassadeur ou créateur de contenus pédagogiques.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="/postuler" class="btn btn--primary">Postuler maintenant</a>
      @if(auth.user)
        <a href="/dashboard" class="btn border border-gray-300 bg-white text-gray-800 hover:bg-gray-50">
          Espace équipe
        </a>
      @else
        <a href="/login" class="btn border border-gray-300 bg-white text-gray-800 hover:bg-gray-50">
          Espace équipe
        </a>
      @end
    </div>
  </main>
@end