@layouts.app({ title: 'Mes offres' })
  <div class="page">
    <div class="page__header">
      <div>
        <h1 class="page__title">{{ auth.user.companyName }}</h1>
        <p class="page__description">Vos offres d'emploi et leur état de publication.</p>
      </div>
      <div class="page__actions">
        <a href="/entreprise/offres/nouvelle" class="btn btn--primary">Nouvelle offre</a>
      </div>
    </div>

    @if(offers.length)
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Offre</th>
              <th>Contrat</th>
              <th>Statut</th>
              <th>Date limite</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(offer in offers)
              <tr>
                <td>
                  <div class="table__name">{{ offer.title }}</div>
                  <div class="table__sub">
                    {{ workModes[offer.workMode] ?? offer.workMode }}
                    · {{ offer.location ?? 'Lieu non précisé' }}
                  </div>
                </td>
                <td>{{ contractTypes[offer.contractType] ?? offer.contractType }}</td>
                <td>
                  <span class="badge badge--{{ offer.status }}">
                    {{ offerStatuses[offer.status] ?? offer.status }}
                  </span>
                </td>
                <td>{{ offer.deadline ? offer.deadline.toFormat('dd/MM/yyyy') : '—' }}</td>
                <td>
                  <div class="table__actions">
                    <a href="/entreprise/offres/{{ offer.id }}/modifier" class="btn btn--secondary btn--sm">Modifier</a>

                    @if(offer.status === 'published')
                      <a href="/offres/{{ offer.id }}" class="btn btn--secondary btn--sm">Voir</a>
                      <form method="POST" action="/entreprise/offres/{{ offer.id }}/statut">
                        {{ csrfField() }}
                        <input type="hidden" name="status" value="closed" />
                        <button type="submit" class="btn btn--secondary btn--sm">Clôturer</button>
                      </form>
                    @elseif(offer.status === 'draft')
                      <form method="POST" action="/entreprise/offres/{{ offer.id }}/statut">
                        {{ csrfField() }}
                        <input type="hidden" name="status" value="published" />
                        <button type="submit" class="btn btn--primary btn--sm">Publier</button>
                      </form>
                    @else
                      <form method="POST" action="/entreprise/offres/{{ offer.id }}/statut">
                        {{ csrfField() }}
                        <input type="hidden" name="status" value="published" />
                        <button type="submit" class="btn btn--secondary btn--sm">Rouvrir</button>
                      </form>
                    @end

                    <form method="POST" action="/entreprise/offres/{{ offer.id }}/dupliquer">
                      {{ csrfField() }}
                      <button type="submit" class="btn btn--secondary btn--sm">Dupliquer</button>
                    </form>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
      <p class="hint" style="margin-top: 12px;">
        Une offre n'apparaît publiquement que si elle est « Publiée » et que sa date limite n'est
        pas dépassée.
      </p>
    @else
      <div class="panel" style="text-align: center; color: var(--muted);">
        <p style="font-weight: 600; color: var(--ink);">Vous n'avez pas encore d'offre</p>
        <p style="margin: 6px 0 16px;">
          Publiez votre première offre : les candidats seront classés selon vos critères.
        </p>
        <a href="/entreprise/offres/nouvelle" class="btn btn--primary">Créer ma première offre</a>
      </div>
    @end
  </div>
@end
