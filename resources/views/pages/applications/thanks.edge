@layouts.skullvi({ title: 'Candidature envoyée — SKULLVI' })
  <main class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
    <h1 class="font-script text-4xl text-brand-green">Merci !</h1>
    <p class="mt-4 text-lg font-semibold">Votre candidature a bien été envoyée.</p>
    <p class="mt-2 text-gray-600">
      Notre équipe l'examine et reviendra vers vous par email.
    </p>
    <a href="/" class="btn btn--primary mt-8">Retour à l'accueil</a>
  </main>
@end