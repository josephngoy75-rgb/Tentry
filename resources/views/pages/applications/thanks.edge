@layouts.talentry({ title: 'Candidature envoyée — Talentry' })
  <main class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-400">Merci !</h1>
    <p class="mt-4 text-lg font-semibold text-white">Votre candidature a bien été envoyée.</p>
    <p class="mt-2 text-slate-400">Elle sera examinée prochainement.</p>
    <a href="/" class="btn btn--primary mt-8">Retour à l'accueil</a>
  </main>
@end
