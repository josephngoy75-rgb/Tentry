@layouts.talentry({ title: `${company.companyName} — Talentry` })
  <main class="mx-auto max-w-4xl px-6 py-12">
    <a href="/offres" class="text-sm text-gray-500 hover:text-brand-green">← Toutes les offres</a>

    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-brand-dark">{{ company.companyName }}</h1>

      <div class="mt-3 flex flex-wrap gap-2">
        @if(sectorLabel)
          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">{{ sectorLabel }}</span>
        @end
        @if(sizeLabel)
          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">{{ sizeLabel }}</span>
        @end
        @if(profile && profile.foundedYear)
          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">Fondée en {{ profile.foundedYear }}</span>
        @end
      </div>

      @if(profile && profile.description)
        <section class="mt-8">
          <h2 class="border-l-4 border-brand-orange pl-3 text-lg font-bold">À propos</h2>
          <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ profile.description }}</p>
        </section>
      @end

      @if(profile && (profile.addressLine || profile.city || profile.country))
        <section class="mt-8">
          <h2 class="border-l-4 border-brand-blue pl-3 text-lg font-bold">Adresse</h2>
          <p class="mt-3 text-gray-700">
            @if(profile.addressLine){{ profile.addressLine }}<br />@end
            {{ [profile.city, profile.country].filter(Boolean).join(', ') }}
          </p>
        </section>
      @end

      @if(links.length)
        <section class="mt-8">
          <h2 class="border-l-4 border-brand-green pl-3 text-lg font-bold">Liens</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            @each(link in links)
              <a
                href="{{ link.url }}"
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="rounded-full border border-gray-300 px-4 py-1.5 text-sm font-medium text-gray-800 hover:border-brand-green hover:text-brand-green"
              >
                {{ link.label }}
              </a>
            @end
          </div>
        </section>
      @end

      @if(!profile || (!profile.description && !profile.addressLine && !links.length))
        <p class="mt-8 text-sm text-gray-500">Cette entreprise n'a pas encore complété son profil.</p>
      @end
    </div>

    <h2 class="mt-12 text-2xl font-extrabold tracking-tight text-brand-dark">
      Offres en cours ({{ offers.length }})
    </h2>

    @if(offers.length)
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        @each(offer in offers)
          <a
            href="/offres/{{ offer.id }}"
            class="block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-brand-green hover:shadow-md"
          >
            <h3 class="text-lg font-bold text-brand-dark">{{ offer.title }}</h3>
            <p class="mt-1 text-sm text-gray-500">{{ offer.location ?? 'Lieu non précisé' }}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
                {{ contractTypes[offer.contractType] ?? offer.contractType }}
              </span>
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
                {{ workModes[offer.workMode] ?? offer.workMode }}
              </span>
            </div>
          </a>
        @end
      </div>
    @else
      <p class="mt-4 rounded-2xl border border-dashed border-gray-300 p-8 text-center text-gray-500">
        Aucune offre en cours pour le moment.
      </p>
    @end
  </main>
@end
