@layouts.talentry({ title: `${offer.title} — Talentry` })
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a href="/offres" class="text-sm text-gray-500 hover:text-brand-green">← Toutes les offres</a>

    <p class="mt-6 text-sm font-medium text-brand-green">{{ companyName }}</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-brand-dark">{{ offer.title }}</h1>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
        {{ contractTypes[offer.contractType] ?? offer.contractType }}
      </span>
      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
        {{ workModes[offer.workMode] ?? offer.workMode }}
      </span>
      @if(offer.location)
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">{{ offer.location }}</span>
      @end
      @if(offer.salaryRange)
        <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700">{{ offer.salaryRange }}</span>
      @end
    </div>

    @if(offer.deadline)
      <p class="mt-3 text-sm text-gray-500">Candidatures jusqu'au {{ offer.deadline.toFormat('dd/MM/yyyy') }}</p>
    @end

    <div class="mt-8 space-y-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <h2 class="border-l-4 border-brand-orange pl-3 text-lg font-bold">À propos du poste</h2>
        <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ offer.summary }}</p>
      </section>

      <section>
        <h2 class="border-l-4 border-brand-orange pl-3 text-lg font-bold">Missions</h2>
        <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ offer.missions }}</p>
      </section>

      @if(offer.profile)
        <section>
          <h2 class="border-l-4 border-brand-orange pl-3 text-lg font-bold">Profil recherché</h2>
          <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ offer.profile }}</p>
        </section>
      @end

      <section>
        <h2 class="border-l-4 border-brand-blue pl-3 text-lg font-bold">Ce que l'on attend de vous</h2>
        <dl class="mt-3 space-y-3 text-sm">
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-44 font-semibold text-gray-500">Compétences requises</dt>
            <dd class="flex flex-wrap gap-1.5">
              @each(skill in offer.requiredSkills)
                <span class="rounded-md bg-green-50 px-2 py-0.5 text-xs font-medium text-green-800">{{ skill }}</span>
              @end
            </dd>
          </div>
          @if(offer.niceSkills.length)
            <div class="flex flex-wrap items-baseline gap-2">
              <dt class="w-44 font-semibold text-gray-500">Un plus</dt>
              <dd class="flex flex-wrap gap-1.5">
                @each(skill in offer.niceSkills)
                  <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">{{ skill }}</span>
                @end
              </dd>
            </div>
          @end
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-44 font-semibold text-gray-500">Expérience</dt>
            <dd>{{ offer.minExperienceYears }} an(s) minimum</dd>
          </div>
          @if(offer.educationLevel)
            <div class="flex flex-wrap items-baseline gap-2">
              <dt class="w-44 font-semibold text-gray-500">Niveau d'études</dt>
              <dd>{{ educationLevels[offer.educationLevel]?.label ?? offer.educationLevel }}</dd>
            </div>
          @end
          @if(offer.languages.length)
            <div class="flex flex-wrap items-baseline gap-2">
              <dt class="w-44 font-semibold text-gray-500">Langues</dt>
              <dd>{{ offer.languages.join(', ') }}</dd>
            </div>
          @end
        </dl>
      </section>

      @if(offer.benefits)
        <section>
          <h2 class="border-l-4 border-brand-orange pl-3 text-lg font-bold">Avantages</h2>
          <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ offer.benefits }}</p>
        </section>
      @end
    </div>

    <div class="mt-8 rounded-2xl border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">
      La candidature en ligne arrive très bientôt.
    </div>
  </main>
@end
