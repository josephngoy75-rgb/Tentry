@layouts.talentry({ title: 'Offres d\'emploi — Talentry' })
  <main class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-brand-dark">Offres d'emploi</h1>
    <p class="mt-2 text-gray-600">Trouvez le poste qui correspond à votre profil.</p>

    <form method="GET" action="/offres" class="mt-8 flex flex-wrap items-center gap-3" x-data>
      <input
        type="search"
        name="q"
        value="{{ filters.q }}"
        placeholder="Poste ou lieu…"
        class="field__input"
        style="max-width: 260px;"
      />
      <select name="contract" class="field__input" style="max-width: 190px;" x-on:change="$el.form.submit()">
        <option value="">Tous les contrats</option>
        @each((label, key) in contractTypes)
          <option value="{{ key }}" {{ filters.contract === key ? 'selected' : '' }}>{{ label }}</option>
        @end
      </select>
      <select name="mode" class="field__input" style="max-width: 190px;" x-on:change="$el.form.submit()">
        <option value="">Tous les modes</option>
        @each((label, key) in workModes)
          <option value="{{ key }}" {{ filters.mode === key ? 'selected' : '' }}>{{ label }}</option>
        @end
      </select>
      <button type="submit" class="btn btn--primary">Rechercher</button>
      <a href="/offres" class="px-2 text-sm text-gray-500 hover:text-brand-green">Réinitialiser</a>
    </form>

    @if(offers.length)
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        @each(offer in offers)
          <a
            href="/offres/{{ offer.id }}"
            class="block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-brand-green hover:shadow-md"
          >
            <p class="text-sm font-medium text-brand-green">{{ companyNames[offer.userId] }}</p>
            <h2 class="mt-1 text-lg font-bold text-brand-dark">{{ offer.title }}</h2>
            <p class="mt-1 text-sm text-gray-500">{{ offer.location ?? 'Lieu non précisé' }}</p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
                {{ contractTypes[offer.contractType] ?? offer.contractType }}
              </span>
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
                {{ workModes[offer.workMode] ?? offer.workMode }}
              </span>
              @if(offer.salaryRange)
                <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700">
                  {{ offer.salaryRange }}
                </span>
              @end
            </div>

            <div class="mt-4 flex flex-wrap gap-1.5">
              @each(skill in offer.requiredSkills.slice(0, 4))
                <span class="rounded-md bg-green-50 px-2 py-0.5 text-xs text-green-800">{{ skill }}</span>
              @end
            </div>
          </a>
        @end
      </div>

      @if(offers.hasPages)
        <div class="mt-8 flex items-center justify-center gap-4">
          @if(offers.currentPage > 1)
            <a class="btn border border-gray-300 bg-white text-gray-800 hover:bg-gray-50" href="{{ offers.getUrl(offers.currentPage - 1) }}">← Précédent</a>
          @end
          <span class="text-sm text-gray-500">Page {{ offers.currentPage }} / {{ offers.lastPage }}</span>
          @if(offers.hasMorePages)
            <a class="btn border border-gray-300 bg-white text-gray-800 hover:bg-gray-50" href="{{ offers.getUrl(offers.currentPage + 1) }}">Suivant →</a>
          @end
        </div>
      @end
    @else
      <div class="mt-10 rounded-2xl border border-dashed border-gray-300 p-12 text-center text-gray-500">
        Aucune offre ne correspond à votre recherche.
      </div>
    @end
  </main>
@end
