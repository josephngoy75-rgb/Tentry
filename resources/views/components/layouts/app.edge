{{--
  Navigation principale de l'espace connecté, adaptée au rôle.
  Ajouter une entrée ici pour chaque nouvelle section.
--}}
@let(role = auth.user ? auth.user.role : '')
@let(navByRole = {
  admin: [{ label: 'Candidatures', route: 'dashboard', icon: 'lucide:users' }],
  company: [{ label: 'Mes offres', route: 'company.offers.index', icon: 'lucide:briefcase' }],
  candidate: [{ label: 'Offres', route: 'offers.index', icon: 'lucide:search' }],
})
@let(nav = navByRole[role] ?? [])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} — Talentry` : 'Talentry' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 34, light: true })
        <div class="header__right">
          @if(auth.user)
            <span style="font-size: 13.5px; color: #d1d5db;">{{ auth.user.fullName }}</span>
          @end
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="btn btn--secondary btn--sm">
              @svg('lucide:log-out', { width: 15, height: 15 })
              Déconnexion
            </button>
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
