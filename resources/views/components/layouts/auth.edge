<!DOCTYPE html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Espace équipe — SKULLVI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 44 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div></div>

        <p class="auth__quote">Partage. Apprends. Gagne.</p>

        <div>
          <div class="pitch__t">Transforme ton savoir en succès</div>
          <p class="pitch__p">
            SKULLVI aide les apprenants à réviser, progresser et développer des compétences utiles
            pour l'école et le monde professionnel.
          </p>
          <a class="il pitch__a" href="https://www.skullvi.org" target="_blank" rel="noreferrer">
            Découvrir SKULLVI →
          </a>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>