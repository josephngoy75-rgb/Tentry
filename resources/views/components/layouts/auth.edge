<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Talentry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    @vite(['resources/css/talentry.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 30 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div></div>

        <p class="auth__quote">Le bon talent, la bonne offre.</p>

        <div>
          <div class="pitch__t">Recrutez et postulez plus intelligemment</div>
          <p class="pitch__p">
            Talentry met en relation entreprises et candidats : l'analyse du CV et le score font
            ressortir les profils qui correspondent vraiment à l'offre.
          </p>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
